# Copy this file to .env.local and fill in your values.

# 1. Radar data (Outages, Threats tabs): Cloudflare dashboard -> My Profile
#    -> API Tokens -> Create Custom Token -> Permissions:
#      Account > Radar > Read
CLOUDFLARE_API_TOKEN=

# 2. URL Scanner (Investigate tab) needs the SAME token above to also have:
#      Account > URL Scanner > Edit
#    (edit the token's permissions, or create a second one with both)

# 3. URL Scanner is account-scoped, so it also needs your account ID.
#    Find it: Cloudflare dashboard -> any domain's Overview page, right
#    sidebar -> "Account ID" (or accounts.cloudflare.com -> API section).
CLOUDFLARE_ACCOUNT_ID=

# 4. Flights tab works with NO credentials (OpenSky anonymous access).
#    These two are optional, only needed for a higher daily rate limit:
#    opensky-network.org -> sign up (free) -> profile -> API Client ->
#    create one -> copy the client ID and secret below.
#    (OpenSky retired username/password Basic Auth in March 2026 — these
#    must be an OAuth2 API Client, not your login password.)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
